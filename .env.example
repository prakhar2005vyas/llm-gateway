# ─────────────────────────────────────────────────────────────────────────────
# LLM Gateway — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only Phase 0 variables are listed; later phases add their own here.
# ─────────────────────────────────────────────────────────────────────────────

# --- Upstream provider (the LLM the gateway forwards to) ---------------------
# Any OpenAI-compatible endpoint. Examples:
#   OpenAI     https://api.openai.com/v1
#   Fireworks  https://api.fireworks.ai/inference/v1
#   Together   https://api.together.xyz/v1
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=changeme

# --- Reliability knobs (timeouts + retries on the upstream call) -------------
UPSTREAM_TIMEOUT_SECONDS=60
UPSTREAM_MAX_RETRIES=2

# --- Gateway auth (optional in Phase 0) --------------------------------------
# If set, clients must send `Authorization: Bearer <this value>`.
# Leave empty to disable the check (pass-through mode).
GATEWAY_API_KEY=

# --- Database (Phase 1) -------------------------------------------------------
# Password for the dockerized Postgres (compose reads it; default is fine for
# local dev, change it anywhere shared).
POSTGRES_PASSWORD=gateway_dev_pw
# DATABASE_URL is set by docker-compose for the containerized gateway.
# Only set it here when running the backend OUTSIDE compose, e.g.:
# DATABASE_URL=postgresql+asyncpg://gateway:gateway_dev_pw@localhost:5432/gateway
# Hard ceiling on one cold-path trace/cache write. A write wedged on a
# frozen DB is cancelled and shed at this deadline so it can never hold a
# keep-alive connection (and the requests pipelined on it) hostage.
TRACE_WRITE_TIMEOUT_SECONDS=5

# --- Semantic cache (Phase 3) --------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity for a hit. 0.90 tuned for all-MiniLM-L6-v2: paraphrases
# score ~0.92+, adversarial near-misses ("delete my account" vs "recover my
# account") ~0.71. Raise toward 0.99 for stricter (safer, fewer hits).
CACHE_SIMILARITY_THRESHOLD=0.90
# Only requests with explicit temperature <= this are cached (creative calls
# must never be served one frozen answer).
CACHE_MAX_TEMPERATURE=0.2
EMBEDDING_MODEL_ID=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Failover (Phase 4) ---------------------------------------------------------
# Secondary OpenAI-compatible provider, used only after the primary exhausts
# all retries (transport errors or persistent 5xx). Empty = disabled.
#   Fireworks: https://api.fireworks.ai/inference/v1
#   Together:  https://api.together.xyz/v1
FAILOVER_BASE_URL=
FAILOVER_API_KEY=

# --- Rate limiting (Phase 4) -----------------------------------------------------
# Per-key (client bearer token) sliding window. In-memory, per-process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Request coalescing (Phase 4) ----------------------------------------------
COALESCE_ENABLED=true
# Only requests with explicit temperature <= this share one upstream call
# (collapsing creative calls into one answer would be a correctness bug).
COALESCE_MAX_TEMPERATURE=0.2

# --- Eval harness (Phase 6) -----------------------------------------------------
# Fraction of successful traffic scored by an LLM judge (0.0 = off).
# Evals cost real tokens — 0.05 (5%) is a sane production setting.
EVAL_SAMPLE_RATE=0.0
# OpenAI-compatible judge endpoint; empty = sampled evals marked 'skipped'.
EVAL_BASE_URL=https://api.fireworks.ai/inference/v1
EVAL_API_KEY=
EVAL_MODEL_ID=accounts/fireworks/models/llama-v3p3-70b-instruct
EVAL_MAX_CONCURRENT=4

# --- Server ------------------------------------------------------------------
LOG_LEVEL=INFO
