# ─────────────────────────────────────────────────────────────────────────────
# LLM Gateway — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only Phase 0 variables are listed; later phases add their own here.
# ─────────────────────────────────────────────────────────────────────────────

# --- Upstream provider (the LLM the gateway forwards to) ---------------------
# The gateway speaks to ANY OpenAI-compatible endpoint: switching providers is
# swapping base URL + key here — no code changes.
# By default, the model id in each request is forwarded VERBATIM. 
# You can override this by setting UPSTREAM_MODEL_ID to rewrite the model name
# before sending it to the provider (useful for provider migrations).
#
# ── Free-tier recipes ─────────────────────────────────────────────────────────
# Groq (free tier — the default below):
#   UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
#   UPSTREAM_API_KEY=<your Groq key (gsk_...)>
#   request models: llama-3.1-8b-instant, openai/gpt-oss-120b (Note: Groq deprecated llama-3.3-70b-versatile in August 2026)
#
# Google Gemini (OpenAI-compatible endpoint):
#   UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   UPSTREAM_API_KEY=<your Gemini key>
#   request models: gemini-1.5-flash, gemini-2.0-flash
#
# Ollama, local (free, keyless — any non-empty key placeholder works):
#   UPSTREAM_BASE_URL=http://localhost:11434/v1
#     (from the dockerized gateway: http://host.docker.internal:11434/v1)
#   UPSTREAM_API_KEY=ollama
#   request models: llama3 etc. — the plain Ollama model name. NOT
#   "ollama/llama3": that prefix is a LiteLLM convention; this gateway
#   forwards the id verbatim and Ollama would reject it.
#
# Paid examples: OpenAI https://api.openai.com/v1 · Fireworks
# https://api.fireworks.ai/inference/v1 · Together https://api.together.xyz/v1
UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_API_KEY=gsk_YOUR_KEY_HERE
# Optional: Force-rewrite all unrouted traffic to this model ID (e.g. openai/gpt-oss-120b, formerly llama-3.3-70b-versatile)
UPSTREAM_MODEL_ID=

# --- Routing (Phase 8) -------------------------------------------------------
# Multi-model gateway routing. Bypass the default failover chain by directing
# specific requested models to their own dedicated upstream.
# Format: JSON object mapping requested model name to route configuration.
# Example: '{"llama-3.1-8b-instant": {"base_url": "https://api.groq.com/openai/v1", "api_key": "gsk_FAKE_KEY", "model_id": "llama-3.1-8b-instant", "provider_label": "groq"}}'
MODEL_ROUTES_JSON="{}"

# --- Reliability knobs (timeouts + retries on the upstream call) -------------
UPSTREAM_TIMEOUT_SECONDS=60
UPSTREAM_MAX_RETRIES=2

# --- Gateway auth (optional in Phase 0) --------------------------------------
# If set, clients must send `Authorization: Bearer <this value>`.
# Leave empty to disable the check (pass-through mode).
GATEWAY_API_KEY=my_secure_local_password

# --- Database (Phase 1) -------------------------------------------------------
# Password for the dockerized Postgres (compose reads it; default is fine for
# local dev, change it anywhere shared).
POSTGRES_PASSWORD=gateway_dev_pw
# DATABASE_URL is set by docker-compose for the containerized gateway.
# Only set it here when running the backend OUTSIDE compose, e.g.:
# DATABASE_URL=postgresql+asyncpg://gateway:gateway_dev_pw@localhost:5432/gateway
# Hard ceiling on one cold-path trace/cache write. A write wedged on a
# frozen DB is cancelled and shed at this deadline so it can never hold a
# keep-alive connection (and the requests pipelined on it) hostage.
TRACE_WRITE_TIMEOUT_SECONDS=5

# --- Semantic cache (Phase 3) --------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity for a hit. 0.90 tuned for all-MiniLM-L6-v2: paraphrases
# score ~0.92+, adversarial near-misses ("delete my account" vs "recover my
# account") ~0.71. Raise toward 0.99 for stricter (safer, fewer hits).
CACHE_SIMILARITY_THRESHOLD=0.90
# Only requests with explicit temperature <= this are cached (creative calls
# must never be served one frozen answer).
CACHE_MAX_TEMPERATURE=0.2
EMBEDDING_MODEL_ID=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Failover (Phase 4) ---------------------------------------------------------
# Secondary OpenAI-compatible provider, used only after the primary exhausts
# all retries (transport errors or persistent 5xx). Empty = disabled.
# NOTE: By default, the request's model id is forwarded to the failover VERBATIM.
# If your failover provider expects a completely different model name (e.g. Groq 
# primary to Gemini failover), set FAILOVER_MODEL_ID to rewrite it automatically.
#
# Example (Gemini as failover):
# FAILOVER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FAILOVER_API_KEY=<your Gemini API key>
# FAILOVER_MODEL_ID=gemini-1.5-flash
FAILOVER_BASE_URL=
FAILOVER_API_KEY=
FAILOVER_MODEL_ID=

# --- Rate limiting (Phase 4) -----------------------------------------------------
# Per-key (client bearer token) sliding window. In-memory, per-process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Request coalescing (Phase 4) ----------------------------------------------
COALESCE_ENABLED=true
# Only requests with explicit temperature <= this share one upstream call
# (collapsing creative calls into one answer would be a correctness bug).
COALESCE_MAX_TEMPERATURE=0.2

# --- Eval harness (Phase 6) -----------------------------------------------------
# Fraction of successful traffic scored by an LLM judge (0.0 = off).
# Evals cost real tokens — 0.05 (5%) is a sane production setting.
EVAL_SAMPLE_RATE=0.05
# OpenAI-compatible judge endpoint; empty = sampled evals marked 'skipped'.
EVAL_BASE_URL=https://api.fireworks.ai/inference/v1
EVAL_API_KEY=fw_YOUR_KEY_HERE
EVAL_MODEL_ID=accounts/fireworks/models/llama-v3p3-70b-instruct
EVAL_MAX_CONCURRENT=4

# --- Server ------------------------------------------------------------------
LOG_LEVEL=INFO
